# Copy this file to .env and fill in your values
# .env is gitignored — never commit the real .env

# Hugging Face token (required by vLLM to load GGUF metadata)
HF_TOKEN=hf_your_token_here
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Your Telegram user ID — get it from @userinfobot
ALLOWED_CHAT_ID=your_telegram_user_id

# Telegram bot token — get it from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALLOWED_CHANNEL_ID=your_discord_channel_id_here
DISCORD_OPERATOR_ID=your_discord_user_id_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Ollama Tuning
OLLAMA_NUM_PARALLEL=4

# Gmail Integration (Base64 encoded JSON or path to credentials.json)
GMAIL_CREDENTIALS_JSON={}

# GitHub Personal Access Token — get it from https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
