# Copy this file to .env and fill in your values
# .env is gitignored — never commit the real .env

# Hugging Face token (required by vLLM to load GGUF metadata)
HF_TOKEN=hf_your_token_here
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Your Telegram user ID — get it from @userinfobot
ALLOWED_CHAT_ID=your_telegram_user_id

# Telegram bot token — get it from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALLOWED_CHANNEL_ID=your_discord_channel_id_here
DISCORD_OPERATOR_ID=your_discord_user_id_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Local LLM (llama-server, OpenAI-compatible) — consultation, scoring, and
# escalation all route here by default. From the host (Councilor), the
# default 127.0.0.1 is correct as-is. Containers (icarus-api, email_triage)
# override this to http://host.docker.internal:8080/v1 in docker-compose.yml.
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=local
# Optional: embedding-capable server for semantic memory search (a server
# started with --embeddings — the main chat-completion instance above does
# not serve embeddings). Leave unset to run FTS5-only.
# Set up with: llama.cpp/start_icarus_embedding.sh (Qwen3-Embedding-0.6B, :8090)
LOCAL_EMBEDDING_URL=http://127.0.0.1:8090
LOCAL_EMBEDDING_DIM=1024

# Ollama Tuning
OLLAMA_NUM_PARALLEL=4
# Model used for email priority scoring (must be available in Ollama)
EMAIL_SCORER_MODEL=qwen3.5:4b

# Gmail Integration
# Personal Gmail OAuth (recommended for @gmail.com inboxes)
# Generate a refresh token with: python backend/scripts/generate_gmail_refresh_token.py
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Deprecated fallback (Workspace service-account only; not for personal Gmail)
# Provide the service account credentials as raw JSON or base64-encoded JSON.
GMAIL_CREDENTIALS_JSON=
# Optional delegated user when using a Workspace service account
GMAIL_IMPERSONATE_USER=

# Google Calendar (optional, read-only) — reuses the GMAIL_OAUTH_CLIENT_ID/
# _SECRET above (same GCP OAuth client), just needs its own consented scope.
# Generate with: python backend/scripts/generate_calendar_refresh_token.py
GOOGLE_CALENDAR_OAUTH_REFRESH_TOKEN=

# GitHub Personal Access Token — get it from https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Google AI API Key (optional — cloud overflow only, not used by default)
# Get from: https://aistudio.google.com/apikey
# Consultation, scoring, and escalation all route to the local LLM above now.
# This key is only read if the dormant cloud path in llm_router.py is
# deliberately re-enabled for a task that exceeds local capability.
GOOGLE_API_KEY=your_api_key_here

# Google Cloud Pub/Sub — for Gmail push notifications (email triage agent)
# Set up a topic and subscription in your GCP project, then:
# Grant gmail-api-push@system.gserviceaccount.com Pub/Sub Publisher on the topic
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/icarus-gmail
GMAIL_PUBSUB_SUBSCRIPTION=projects/YOUR_PROJECT/subscriptions/icarus-gmail-sub
