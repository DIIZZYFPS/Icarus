# Copy this file to .env and fill in your values
# .env is gitignored — never commit the real .env

# Hugging Face token (required by vLLM to load GGUF metadata)
HF_TOKEN=hf_your_token_here
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Your Telegram user ID — get it from @userinfobot
ALLOWED_CHAT_ID=your_telegram_user_id

# Telegram bot token — get it from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALLOWED_CHANNEL_ID=your_discord_channel_id_here
DISCORD_OPERATOR_ID=your_discord_user_id_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Ollama Tuning
OLLAMA_NUM_PARALLEL=4
# Model used for email priority scoring (must be available in Ollama)
EMAIL_SCORER_MODEL=qwen3.5:4b

# Gmail Integration
# Personal Gmail OAuth (recommended for @gmail.com inboxes)
# Generate a refresh token with: python backend/scripts/generate_gmail_refresh_token.py
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Deprecated fallback (Workspace service-account only; not for personal Gmail)
# Provide the service account credentials as raw JSON or base64-encoded JSON.
GMAIL_CREDENTIALS_JSON=
# Optional delegated user when using a Workspace service account
GMAIL_IMPERSONATE_USER=

# GitHub Personal Access Token — get it from https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
