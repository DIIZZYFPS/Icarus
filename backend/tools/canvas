#!/usr/bin/env python3
"""canvas — a read-only Canvas LMS client for Claude Code tasks (see claude_runner workspaces).

    canvas get /api/v1/courses?enrollment_state=active
    canvas get /api/v1/courses/123/assignments --all
    canvas download <file url from a files response> notes/lecture1.pdf

The token comes from CANVAS_API_TOKEN and the host from CANVAS_BASE_URL; neither is ever
printed. Only GET requests, only to that host, only under /api/v1/ (downloads: only that host's
file URLs), and downloads land inside the current directory. Stdlib only.
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

MAX_PAGES = 20
TIMEOUT = 30
MAX_DOWNLOAD_BYTES = 200 * 1024 * 1024


def fail(message: str, code: int = 1):
    print(f"canvas: {message}", file=sys.stderr)
    sys.exit(code)


def config() -> tuple[str, str]:
    base = os.environ.get("CANVAS_BASE_URL", "").strip().rstrip("/")
    token = os.environ.get("CANVAS_API_TOKEN", "").strip()
    if not base or not token:
        fail("CANVAS_BASE_URL and CANVAS_API_TOKEN must both be set")
    parsed = urllib.parse.urlparse(base)
    if parsed.scheme != "https" or not parsed.netloc:
        fail("CANVAS_BASE_URL must be an https URL like https://school.instructure.com")
    return f"https://{parsed.netloc}", token


def request(url: str, token: str):
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}", "Accept": "application/json"}, method="GET")
    try:
        return urllib.request.urlopen(req, timeout=TIMEOUT)
    except urllib.error.HTTPError as e:
        fail(f"HTTP {e.code} for {urllib.parse.urlparse(url).path}")
    except urllib.error.URLError as e:
        fail(f"couldn't reach Canvas: {e.reason}")


def next_link(header: str | None) -> str | None:
    for part in (header or "").split(","):
        segment = part.split(";")
        if len(segment) > 1 and 'rel="next"' in segment[1]:
            return segment[0].strip().strip("<>")
    return None


def get(path: str, everything: bool) -> None:
    base, token = config()
    parsed = urllib.parse.urlparse(path)
    if parsed.scheme or parsed.netloc or not parsed.path.startswith("/api/v1/"):
        fail("path must look like /api/v1/... (the host is fixed)")
    url = base + path
    pages = []
    for _ in range(MAX_PAGES if everything else 1):
        with request(url, token) as resp:
            body = json.loads(resp.read().decode("utf-8", errors="replace") or "null")
            link = next_link(resp.headers.get("Link"))
        pages.append(body)
        if not everything or not link:
            break
        if urllib.parse.urlparse(link).netloc != urllib.parse.urlparse(base).netloc:
            fail("refusing to follow a pagination link to another host")
        url = link
    if everything and all(isinstance(p, list) for p in pages):
        pages = [item for page in pages for item in page]
    else:
        pages = pages[0] if len(pages) == 1 else pages
    json.dump(pages, sys.stdout, indent=1)
    print()


def download(url: str, dest: str) -> None:
    base, token = config()
    if urllib.parse.urlparse(url).netloc != urllib.parse.urlparse(base).netloc:
        fail("downloads must be files on the configured Canvas host")
    root = os.path.realpath(os.getcwd())
    target = os.path.realpath(os.path.join(root, dest))
    if target != root and not target.startswith(root + os.sep):
        fail("destination must be inside the current folder")
    os.makedirs(os.path.dirname(target), exist_ok=True)
    size = 0
    with request(url, token) as resp, open(target, "wb") as out:
        while chunk := resp.read(1 << 16):
            size += len(chunk)
            if size > MAX_DOWNLOAD_BYTES:
                out.close()
                os.unlink(target)
                fail("file is larger than 200 MB; not downloaded")
            out.write(chunk)
    print(f"saved {os.path.relpath(target, root)} ({size} bytes)")


def main(argv: list[str]) -> None:
    if len(argv) >= 2 and argv[0] == "get":
        get(argv[1], "--all" in argv[2:])
    elif len(argv) == 3 and argv[0] == "download":
        download(argv[1], argv[2])
    else:
        fail("usage: canvas get /api/v1/<path> [--all]  |  canvas download <file url> <dest>", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
