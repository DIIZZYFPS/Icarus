[Unit]
Description=Icarus desktop avatar daemon
# Started by Hyprland (exec-once systemctl --user start icarus-desktop) once the Wayland
# environment is imported; plain Hyprland never activates graphical-session.target.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/Projects/Icarus/desktop/bin/icarus-desktop run
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
